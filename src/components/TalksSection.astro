---
import type { CollectionEntry } from 'astro:content';
import EntryLinks from './EntryLinks.astro';

interface Props {
    talks: CollectionEntry<'talks'>[];
}

const { talks } = Astro.props;
const resolveImage = (path: string) => path.startsWith('http')
    ? path
    : import.meta.env.BASE_URL + path.replace(/^\/?public\//, '').replace(/^\//, '').replace(/\/$/, '');
---

<section class="list-section" id="talks" aria-labelledby="talks-heading">
    <h2 id="talks-heading">talks & presentations</h2>
    <p class="talks-note">some (most) of these slides will lack some necessary exposition since these were primarily meant to be discussed, not read. any questions are welcome :D</p>
    {talks.length > 0 ? (
        <div class="talks-list">
            {talks.map(({ data }) => (
                <article class="list-item talk-item">
                    <div class:list={['item-image', { 'talk-placeholder': !data.thumbnail }]}>
                        {data.thumbnail
                            ? <img src={resolveImage(data.thumbnail)} alt={data.title} loading="lazy" />
                            : <span aria-hidden="true">talk</span>}
                    </div>
                    <div class="item-content">
                        <h3>{data.title}</h3>
                        {data.authors && <p class="author">{data.authors}</p>}
                        <p class="date">{[data.venue, data.date].filter(Boolean).join(' ')}</p>
                        {data.description && <p class="talk-description">{data.description}</p>}
                        <EntryLinks links={data.links} />
                    </div>
                </article>
            ))}
        </div>
    ) : <p class="talks-empty">talks coming soon.</p>}

    <div class="color-blocks" aria-hidden="true">
        <span class="block magenta"></span>
        <span class="block cyan"></span>
        <span class="block green long"></span>
        <span class="block yellow"></span>
        <span class="block blue"></span>
        <span class="block red"></span>
    </div>
</section>

<style>
    #talks-heading { margin-bottom: 8px; }
    .talks-note { margin: 0 0 20px; font-size: 12px; color: #767877; }
    .talk-item .item-image img { border-width: 1px; }
    .talk-placeholder { display: grid; place-items: center; background: #e8e8e8; color: #767877; border: 1px solid #555; aspect-ratio: 9 / 5; }
    .item-content .talk-description { margin-bottom: 8px; }
    .talks-empty { font-size: 12px; color: #767877; }
</style>
