---
import SEO from '../components/SEO.astro';
import { ViewTransitions } from 'astro:transitions';
import ModelAnswer from '../components/ModelAnswer.astro';
import Favicons from '../components/Favicons.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props {
  title: string;
  subtitle?: string;
  pageTitle?: string;
  fitContent?: boolean;
  image?: string;
  article?: boolean;
  published?: string;
}
const { title, subtitle, pageTitle, fitContent = false, image, article = false, published } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <SEO title={`${pageTitle ?? title} — Nishit Singh`} image={image} article={article} published={published} />
    <link rel="stylesheet" href={import.meta.env.BASE_URL + "style.css"}>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <Favicons />
    <ThemeHead />
    <ViewTransitions />
</head>
<body>
    <ModelAnswer />
    <div class="page-wrapper" style="position: relative;">
        <header>
            <div class="header-left">
                <h1>{title}{subtitle && <span class="pronouns"> {subtitle}</span>}</h1>
            </div>
            <div class="header-right">
                <ThemeToggle />
                <a href={import.meta.env.BASE_URL}>home</a> / <a href={import.meta.env.BASE_URL + "blog"}>blog</a> / <a href="https://github.com/singhnishit" rel="me">github</a>
            </div>
        </header>

        <div class:list={["container", { "container-fit-content": fitContent }]}>
            <slot />
        </div>
    </div>
</body>
</html>
