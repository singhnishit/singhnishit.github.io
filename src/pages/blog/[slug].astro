---
import Layout from '../../layouts/Layout.astro';
import Eliza from '../../components/Eliza.astro';
import BlogContext from '../../components/BlogContext.astro';
import AIDisclosure from '../../components/AIDisclosure.astro';
import { getCollection } from 'astro:content';
import { welfareSeriesSlugs } from '../../utils/blog-series.mjs';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const seriesPosts = welfareSeriesSlugs.includes(post.slug)
    ? await getCollection('blog') : [];
const otherSeriesPosts = welfareSeriesSlugs
    .filter(slug => slug !== post.slug)
    .map(slug => seriesPosts.find(entry => entry.slug === slug))
    .filter(Boolean);
---
<Layout title="blog" pageTitle={post.data.title} image={post.data.thumbnail} article published={post.data.sortDate} fitContent>
    <!-- Dots divider -->
    <div class="dots-divider">
        .........................................................................................................<br>
        .........................................................................................................<br>
        .........................................................................................................<br>
        .........................................................................................................
    </div>

    <div class="blog-post">
        <div class="blog-post-header">
            <h2 class="blog-post-title">{post.data.title}</h2>
            <p class="blog-post-meta">
                {post.data.date}
                {post.data.readTime && <span> | {post.data.readTime} read</span>}
                {post.data.pinned && <span class="blog-pinned-tag"> | PINNED</span>}
            </p>
        </div>

        <div class="blog-post-body">
            <Content />
            {post.slug === 'eliza' && <Eliza />}
        </div>

        {post.data.context && <BlogContext context={post.data.context} />}
        <AIDisclosure entries={post.data.aiDisclosure} />

        {otherSeriesPosts.length > 0 && (
            <nav class="series-related" aria-label="Other posts in this series">
                <p>also in this series · <a href={`${import.meta.env.BASE_URL}series/connected-welfare/`} style="display: inline;">view series →</a></p>
                {otherSeriesPosts.map(entry => (
                    <a href={`${import.meta.env.BASE_URL}blog/${entry.slug}/`}>{entry.data.title} →</a>
                ))}
            </nav>
        )}

        <div class="color-blocks" style="margin-top: 40px;">
            <span class="block red"></span>
            <span class="block blue long"></span>
            <span class="block cyan"></span>
            <span class="block yellow"></span>
            <span class="block magenta"></span>
            <span class="block green"></span>
        </div>

        <p class="blog-back-link"><a href={import.meta.env.BASE_URL + "blog"}>← back to blog</a></p>
    </div>

    <script>
        document.addEventListener("astro:page-load", () => {
            const refs = document.querySelectorAll("sup a[data-footnote-ref]");
            let sidenoteCount = 0;
            refs.forEach(ref => {
                const fnId = ref.getAttribute("href")?.substring(1);
                if (!fnId) return;
                
                const fnElement = document.getElementById(fnId);
                if (fnElement) {
                    // Display equations need the full article width, not a 213px margin.
                    if (fnElement.querySelector('.katex-display')) {
                        // Preserve numbering when text-only notes are hidden on desktop.
                        fnElement.setAttribute('value', String(Array.from(fnElement.parentElement!.children).indexOf(fnElement) + 1));
                        return;
                    }
                    const sidenote = document.createElement("div");
                    sidenote.className = "sidenote";
                    if (sidenoteCount % 2 === 0) sidenote.classList.add("right");
                    else sidenote.classList.add("left");
                    sidenoteCount++;
                    
                    // Copy contents
                    sidenote.innerHTML = fnElement.innerHTML;
                    
                    // Remove the backref link (↩)
                    const backref = sidenote.querySelector("[data-footnote-backref]");
                    if (backref) backref.remove();

                    // Prefix with asterisk inside the p tag so it stays inline
                    const pInside = sidenote.querySelector("p");
                    if (pInside) {
                        pInside.innerHTML = "* " + pInside.innerHTML;
                    } else {
                        sidenote.innerHTML = "* " + sidenote.innerHTML;
                    }

                    // Find the parent paragraph and make it relative to anchor the absolute sidenote
                    const p = ref.closest("p, blockquote, li") as HTMLElement;
                    if (p) {
                        p.style.position = "relative";
                        p.appendChild(sidenote);

                        // Align vertically with the footnote reference
                        const pRect = p.getBoundingClientRect();
                        const refRect = ref.getBoundingClientRect();
                        sidenote.style.top = (refRect.top - pRect.top) + "px";
                    }
                }
            });
        });
    </script>
</Layout>

<style>
    .series-related {
        border: 1px solid var(--text);
        margin-top: 28px;
        padding: 14px 16px;
        font-size: 13px;
    }
    .series-related p { margin: 0 0 10px; color: var(--muted); }
    .series-related a { display: block; width: fit-content; }
    .series-related a + a { margin-top: 8px; }
</style>
