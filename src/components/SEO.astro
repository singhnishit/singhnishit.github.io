---
interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  published?: string;
}
const { title, description, image = '/assets/pfp2.png', article = false, published } = Astro.props;
const home = new URL('/', Astro.site! ).href;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), home).href;
const imageUrl = new URL(image.replace(/^\/?public\//, '/'), home).href;
const person = {
  '@type': 'Person', '@id': `${home}#nishit-singh`, name: 'Nishit Singh',
  alternateName: 'singhnishit', url: home, image: new URL('/assets/pfp2.png', home).href,
  description,
  sameAs: ['https://github.com/singhnishit'],
};
const page = article ? {
  '@type': 'BlogPosting', headline: title.replace(/ — Nishit Singh$/, ''), description,
  url: canonical, mainEntityOfPage: canonical, image: imageUrl,
  author: { '@type': 'Person', '@id': person['@id'], name: person.name, url: home },
  ...(published ? { datePublished: published } : {}),
} : {
  '@type': Astro.url.pathname === '/' ? 'ProfilePage' : 'WebPage',
  url: canonical, name: title, description,
  ...(Astro.url.pathname === '/' ? { mainEntity: { '@id': person['@id'] } } : {}),
};
const structured = { '@context': 'https://schema.org', '@graph': [
  person, { '@type': 'WebSite', '@id': `${home}#website`, name: 'Nishit Singh', url: home }, page,
] };
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="author" content="Nishit Singh" />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content="Nishit Singh" />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={imageUrl} />
{article && published && <meta property="article:published_time" content={published} />}
<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
