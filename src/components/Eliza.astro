<script>
  import { createEliza } from '../scripts/eliza.mjs';
  class ElizaChat extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const form = this.querySelector('form');
      const input = this.querySelector('input');
      const log = this.querySelector('[role="log"]');
      if (!form || !input || !log) return;
      const reply = createEliza();
      input.disabled = false;
      const button = this.querySelector('button');
      if (button) button.disabled = false;
      form.addEventListener('submit', event => {
        event.preventDefault();
        const message = input.value.trim();
        if (!message) return;
        for (const [speaker, text] of [['you', message], ['eliza', reply(message)]]) {
          const line = document.createElement('p');
          line.textContent = speaker === 'eliza' ? `>${text.toUpperCase()}` : `${speaker}: ${text}`;
          log.appendChild(line);
        }
        input.value = '';
        log.scrollTop = log.scrollHeight;
        input.focus();
      });
    }
  }
  if (!customElements.get('eliza-chat')) customElements.define('eliza-chat', ElizaChat);
</script>
<style is:global>
  eliza-chat { display: block; margin: 24px 0; }
  eliza-chat [role="log"] { height: 260px; overflow-y: auto; border: 1px solid #767877; padding: 12px; box-sizing: border-box; overflow-wrap: anywhere; }
  .blog-post-body eliza-chat p { margin: 0 0 10px; }
  eliza-chat form { display: flex; gap: 8px; margin-top: 8px; }
  eliza-chat input, eliza-chat button { font: inherit; color: inherit; background: transparent; border: 1px solid #767877; border-radius: 0; padding: 5px 8px; box-sizing: border-box; }
  eliza-chat input { flex: 1; min-width: 0; width: 100%; }
  eliza-chat button { cursor: pointer; }
  eliza-chat :focus-visible { outline: 2px solid #0050F1; outline-offset: 2px; }
</style>
