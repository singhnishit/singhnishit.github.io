---
import Layout from '../../layouts/Layout.astro';
import BlogPostList from '../../components/BlogPostList.astro';
import { getCollection } from 'astro:content';
import { welfareSeriesSlugs } from '../../utils/blog-series.mjs';

const allPosts = await getCollection('blog');
const posts = welfareSeriesSlugs.map(slug => allPosts.find(post => post.slug === slug)).filter(Boolean);
---
<Layout title="agent identities and welfare" pageTitle="agent identities and welfare — series" fitContent>
    <BlogPostList posts={posts} detailed showSeriesLink={false} />
    <a href={`${import.meta.env.BASE_URL}blog/`}>← all blog posts</a>
</Layout>
